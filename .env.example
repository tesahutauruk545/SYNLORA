APP_NAME=SYNLORA
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TIMEZONE=+07:00
DB_DATABASE=synlora_db
DB_USERNAME=root
DB_PASSWORD=

# Realtime notifikasi: log (nonaktif, dashboard dosen tetap polling) | reverb (aktif; lihat bagian REVERB di bawah)
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=240

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Bawaan 'log': tautan reset password ditulis ke storage/logs (untuk uji lokal). Isi SMTP + ganti ke smtp untuk pemakaian nyata.
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


# Pemantauan fokus (detik)
FOCUS_STALE_SECONDS=60
FOCUS_HIDDEN_GRACE_SECONDS=10
FOCUS_FACE_MISSING_SECONDS=5

# Model deteksi wajah. Utamakan file lokal (php artisan synlora:install-face-model).
# false = jangan pernah mengunduh model dari server Google saat file lokal tidak ada.
MEDIAPIPE_ALLOW_REMOTE_MODEL=true

# Batas per IP (satu kelas sering memakai satu IP kampus, jadi dibuat longgar)
LOGIN_IP_MAX_FAILURES=150
REGISTER_PER_MINUTE=120

# Kapasitas default room, penyimpanan file per room (MB), retensi log (hari, 0 = tidak dihapus)
ROOM_MAX_MEMBERS=60
ROOM_STORAGE_MB=500
LOG_RETENTION_DAYS=0

# Dashboard dosen
MONITOR_POLL_SECONDS=5
MONITOR_CACHE_SECONDS=3

# Registrasi dosen: invite (bawaan, wajib kode) | closed (hanya lewat artisan synlora:make-dosen) | open (TIDAK disarankan)
DOSEN_REGISTRATION=invite
DOSEN_INVITE_CODE=


# ---------------------------------------------------------------- Live Meeting (LiveKit Cloud Free Tier)
# Daftar di https://cloud.livekit.io, buat proyek, lalu salin URL (wss://...) dan API Key/Secret. HANYA di .env, jangan di frontend.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------- Realtime (Laravel Reverb)
# Aktifkan dengan BROADCAST_DRIVER=reverb, isi kunci acak di bawah, lalu jalankan: php artisan reverb:start
REVERB_APP_ID=synlora
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
