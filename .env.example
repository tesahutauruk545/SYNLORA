APP_NAME=SYNLORA
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TIMEZONE=+07:00
DB_DATABASE=synlora_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=240

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email verifikasi & reset password lewat SMTP Gmail.
# MAIL_USERNAME = alamat Gmail pengirim; MAIL_PASSWORD = "App Password" 16 karakter dari akun Google
# (Akun Google > Keamanan > Verifikasi 2 Langkah aktif > Sandi aplikasi), BUKAN password login Gmail.
# MAIL_FROM_ADDRESS harus sama dengan MAIL_USERNAME. Untuk uji lokal tanpa kirim email: MAIL_MAILER=log
# (tautan ditulis ke storage/logs). Pastikan APP_URL di atas berisi alamat situs yang benar (https://...),
# karena tautan verifikasi dan reset dibangun dari APP_URL.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


# Pemantauan fokus (detik)
FOCUS_STALE_SECONDS=60
FOCUS_HIDDEN_GRACE_SECONDS=10
FOCUS_FACE_MISSING_SECONDS=5

# Model deteksi wajah. Utamakan file lokal (php artisan synlora:install-face-model).
# false = jangan pernah mengunduh model dari server Google saat file lokal tidak ada.
MEDIAPIPE_ALLOW_REMOTE_MODEL=true

# Batas per IP (satu kelas sering memakai satu IP kampus, jadi dibuat longgar)
LOGIN_IP_MAX_FAILURES=150
REGISTER_PER_MINUTE=120

# Kapasitas default room, penyimpanan file per room (MB), retensi log (hari, 0 = tidak dihapus)
ROOM_MAX_MEMBERS=60
ROOM_STORAGE_MB=500
LOG_RETENTION_DAYS=0

# Dashboard dosen
MONITOR_POLL_SECONDS=5
MONITOR_CACHE_SECONDS=3

# Registrasi dosen: invite (bawaan, wajib kode) | closed (hanya lewat artisan synlora:make-dosen) | open (TIDAK disarankan)
DOSEN_REGISTRATION=invite
DOSEN_INVITE_CODE=

# Pemantauan per room (kamera/wajah/HP/tab) & notifikasi
RM_STALE_SECONDS=45
RM_CAMERA_LOST_SECONDS=90
RM_ALERT_COOLDOWN=60
RM_PHONE_MIN_CONFIDENCE=0.45
RM_FACE_NOT_FOUND_MS=5000
RM_FACE_AWAY_MS=6000
RM_FACE_TURN_MS=5000
RM_PHONE_FRAMES=3
